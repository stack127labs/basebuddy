# Required to run BaseBuddy.
BASEBUDDY_AUTH_SECRET=
BASEBUDDY_CONTENT_DATABASE_URL=

# Required only for browser creation of the first owner. Generate at least 32 random characters.
# CLI owner setup does not require this token. Remove it after setup if desired.
BASEBUDDY_SETUP_TOKEN=

# Optional: where BaseBuddy stores users, projects, mappings, permissions, and audit data.
# Leave blank for basebuddy-data/. Use supabase-same-project or supabase-split-project for DB-backed app data.
BASEBUDDY_APP_STATE_BACKEND=
BASEBUDDY_APP_STATE_DATABASE_URL=

# Optional: use Supabase buckets for images and files.
BASEBUDDY_SUPABASE_URL=
BASEBUDDY_SUPABASE_PUBLISHABLE_KEY=
BASEBUDDY_SUPABASE_SECRET_KEY=

# Optional: use S3 buckets for images and files.
BASEBUDDY_S3_ACCESS_KEY_ID=
BASEBUDDY_S3_SECRET_ACCESS_KEY=

# Optional: branding and search indexing. Read at startup, so they work with the published image.
# BASEBUDDY_APP_NAME=BaseBuddy
# BASEBUDDY_DOCS_URL=https://basebuddy.stack127.com/docs
# BASEBUDDY_SUPPORT_URL=https://basebuddy.stack127.com/support
# BASEBUDDY_SITE_INDEXABLE=false

# Optional: Docker Compose settings.
# BASEBUDDY_IMAGE=ghcr.io/stack127labs/basebuddy:0.2.2
# BASEBUDDY_PORT=8080
# BASEBUDDY_DOMAIN=basebuddy.example.com
